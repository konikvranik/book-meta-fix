# book-meta-fix configuration
# Copy to .env and edit. The .env file is loaded automatically — searched
# starting from the current directory, walking up to parents until found.
# Real environment variables always take precedence over .env values.

# Library root (the Calibre-style book directory)
BMF_LIBRARY=/mnt/share_nfs/Shared eBooks

# SQLite cache path (relative to CWD unless absolute)
BMF_CACHE=bmf_cache.db

# Default review file path
BMF_REVIEW=review.yaml

# Online enrichers (1/true/yes/on to enable, 0/false/no/off to disable)
# databazeknih.cz — scrapes CZ/SK book DB for genres + metadata (opt-in).
#   No API key needed, but it's web scraping (slower, 2 requests per book).
#   Best source for CZ/SK genres. Enabled per-run with --databazeknih.
BMF_DATABAZEKNIH=0
# OpenLibrary + Google Books — international fallbacks (on by default when
# enrichment is enabled at all).
BMF_OPENLIBRARY=1
BMF_GOOGLE_BOOKS=1

# Enricher negative-cache TTL (seconds). A book whose online lookup found
# nothing is cached as "__NOT_FOUND__" for this long before being retried, so a
# transient API failure or a pre-fix identity gets a second chance. 0 or
# negative = keep negatives forever (never retry). Default 7 days.
BMF_ENRICH_NEGATIVE_TTL=604800

# Z.AI LLM (for C1/C4/C5 reconciliation — phase 7, optional)
# Get a key at https://z.ai/manage-apikey/apikey-list
#
# IMPORTANT: choose the base_url that matches your plan:
#   - Coding plan subscription:  https://api.z.ai/api/coding/paas/v4/
#     (draws from your monthly subscription quota)
#   - PaaS / pay-as-you-go:      https://api.z.ai/api/paas/v4/
#     (per-token billing, requires a purchased resource package)
# Using the wrong one causes 'Insufficient balance' (error 1113) even when
# your coding plan has quota left.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4/
ZAI_MODEL=glm-5.2
# Minimum seconds between LLM requests (RPM throttle). Z.AI's coding plan has a
# dynamic requests-per-minute limit; 429 'Rate limit reached for requests'
# (code 1302) trips when too many calls land in a rolling window. 2.0s caps us
# at ~30 RPM regardless of worker count. Lower (1.0 = 60 RPM) on a higher tier;
# raise (4.0 = 15 RPM) if you still hit 429s. 0 disables throttling.
BMF_LLM_MIN_INTERVAL=2.0
# Leaky-bucket burst capacity (count-per-time limiter, NOT concurrency). Default
# 1 = pure even drip: exactly one LLM call starts every BMF_LLM_MIN_INTERVAL
# seconds, evenly spaced, no bunching. With interval 2.0s that is a steady
# 30 evenly-spaced requests/minute — what Z.AI's sliding-window limit wants.
# A burst >1 lets several calls fire in the same second, which trips the dynamic
# RPM limit (429). Raise only with confirmed rate headroom (e.g. a paid plan).
BMF_LLM_BURST=1.0
# Global 429 cooldown. Z.AI's free tier has a cascade bug: when ONE model gets a
# 429, the others (incl. the paid fallback) get throttled too. So when ANY worker
# sees a 429, ALL workers pause. The cooldown escalates 5/10/20/... with
# consecutive 429s, honours the server's Retry-After when it is longer, and is
# capped by BMF_LLM_RATE_LIMIT_MAX. Lower base = more 429 risk; higher = slower.
BMF_LLM_RATE_LIMIT_BASE=5.0
BMF_LLM_RATE_LIMIT_MAX=60.0
