# book-meta-fix configuration
# Copy to .env and edit. The .env file is loaded automatically — searched
# starting from the current directory, walking up to parents until found.
# Real environment variables always take precedence over .env values.

# Library root (the Calibre-style book directory)
BMF_LIBRARY=/path/to/calibre-library

# SQLite cache path (relative to CWD unless absolute)
BMF_CACHE=bmf_cache.db

# Default review file path
BMF_REVIEW=review.yaml

# Target path pattern for OK books — drives the C13 location detector
# (analyze) and apply's placement step. Default: '{author}/{title} ({id})'.
# Fields: {author} {author_sort} {title} {title_sort} {id} {isbn} {year}
#         {language} {series} {series_index}
#BMF_PATTERN={author}/{title} ({id})

# Folder for books that still have unresolved problems after apply.
# Dead records (no ebook file at all) go to <needfix>/empty/. Default: needfix
#BMF_NEEDFIX_DIR=needfix

# Interface language for CLI/GUI messages (cs | en). Empty/unset = auto-detect
# from the user's locale (LANG/LC_ALL/LC_MESSAGES; cs* -> Czech, else English).
# Can also be set per-run: bmf --lang cs report
#BMF_LANGUAGE=cs

# Online enrichers (1/true/yes/on to enable, 0/false/no/off to disable)
# databazeknih.cz — scrapes CZ/SK book DB for genres + metadata (opt-in).
#   No API key needed, but it's web scraping (slower, 2 requests per book).
#   Best source for CZ/SK genres. Enabled per-run with --databazeknih.
BMF_DATABAZEKNIH=0
# legie.info — scrapes the CZ/SK fantasy/sci-fi DB (opt-in). Complements
#   databazeknih: it indexes short stories ("povídky") and series/universes
#   that databazeknih's book search misses, so it's the strongest identity
#   source for a sci-fi-heavy library. No ISBN/Year/Publisher (identity only).
#   Tried AFTER databazeknih. Enabled per-run with --legie.
BMF_LEGIE=0
# Self-hosted audiobookshelf_czech_metadata instance (opt-in via URL).
#   github.com/stecik/audiobookshelf_czech_metadata — an aggregator over ~17
#   CZ audiobook storefronts (Alza, Audiolibrix, Audioteka, Kosmas,
#   Radioteka, Rozhlas, ...) speaking ABS's custom-provider /search API.
#   Audio-edition metadata (publisher/year/cover/genres); no ISBN endpoint
#   (title+author only). Set the BASE url (…:8000), not the /search endpoint.
#   Empty/unset = disabled. Also settable per-run with --abs-czech URL.
BMF_ABS_CZECH_URL=
# Bearer token — only when the instance runs with AUDIOBOOKSHELF_AUTH_TOKEN.
BMF_ABS_CZECH_TOKEN=
# Your actual Audiobookshelf server — used by `bmf abs-rescan` (see below).
#   ABS keeps its own database and a plain library scan skips folders it
#   considers unchanged, so bmf's writes (metadata.json/.opf, covers) only
#   appear in ABS after a per-item re-scan. Set the BASE url
#   (e.g. http://abs.lan:13378). Empty/unset = abs-rescan is unavailable.
BMF_ABS_URL=
# Admin API token (ABS web UI: Settings -> Users -> API key) — the scan
# endpoints reject non-admin tokens with 403.
BMF_ABS_TOKEN=
# ABS library name or id — only when the server hosts several book
# libraries and auto-detection cannot decide. Empty = auto-detect.
BMF_ABS_LIBRARY=
# Parallel per-item scan workers for `bmf abs-rescan --apply` (each POST
# waits for ABS to re-scan one item; a small pool raises the aggregate rate
# roughly N-fold). 1 = serial. Default 4.
BMF_ABS_WORKERS=4
# OpenLibrary + Google Books — international fallbacks (on by default when
# enrichment is enabled at all).
BMF_OPENLIBRARY=1
BMF_GOOGLE_BOOKS=1

# Enricher negative-cache TTL (seconds). A book whose online lookup found
# nothing is cached as "__NOT_FOUND__" for this long before being retried, so a
# transient API failure or a pre-fix identity gets a second chance. 0 or
# negative = keep negatives forever (never retry). Default 7 days.
BMF_ENRICH_NEGATIVE_TTL=604800

# Z.AI LLM (for C1/C4/C5 reconciliation — phase 7, optional)
# Get a key at https://z.ai/manage-apikey/apikey-list
#
# IMPORTANT: choose the base_url that matches your plan:
#   - Coding plan subscription:  https://api.z.ai/api/coding/paas/v4/
#     (draws from your monthly subscription quota)
#   - PaaS / pay-as-you-go:      https://api.z.ai/api/paas/v4/
#     (per-token billing, requires a purchased resource package)
# Using the wrong one causes 'Insufficient balance' (error 1113) even when
# your coding plan has quota left.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4/
# Separate endpoint for glm-4.x flash models. The coding endpoint's ~5-request
# concurrency ceiling and the PaaS endpoint's are INDEPENDENT, and a coding-
# plan key may call glm-4.x flash on PaaS for FREE (paid models 1113 there —
# no cash balance; glm-5.x flash is not served on PaaS and stays on the
# primary). Empty = AUTO: split when ZAI_BASE_URL is the coding endpoint;
# a URL forces it; 'off' disables the split.
ZAI_FLASH_BASE_URL=
# Primary model of the LLM self-correction loop (first attempt). Empty = default:
# glm-4.7-flash (free) with the loop on; the fallback model with BMF_LLM_LOOP=0
# (a single call goes straight to the quality model).
BMF_LLM_MODEL=
# Paid high-quality fallback model (also the loop-off single-call model).
BMF_LLM_FALLBACK_MODEL=glm-5.3
# Minimum seconds between LLM requests (RPM throttle). Z.AI's coding plan has a
# dynamic requests-per-minute limit; 429 'Rate limit reached for requests'
# (code 1302) trips when too many calls land in a rolling window. 2.0s caps us
# at ~30 RPM regardless of worker count. Lower (1.0 = 60 RPM) on a higher tier;
# raise (4.0 = 15 RPM) if you still hit 429s. 0 disables throttling.
BMF_LLM_MIN_INTERVAL=2.0
# Hard cap on LLM requests RUNNING at the same instant (across all workers,
# models and retries). Z.AI publishes no exact numbers: the coding-plan
# (concurrency) limits are TIED TO THE PLAN TIER and adjusted dynamically
# (docs.z.ai/devpack/usage-policy); ~5 was the measured ceiling of one
# Pro-tier evening (a 12-deep spike drew 7x 429/1302 while a 6-deep burst
# passed; interactive clients — ZCode/chat — draw from the same ceiling), so
# with 10 workers and slow reasoning calls the fallback herd blows past it and
# the storms also surface as FALSE 1113 'insufficient balance' with quota left
# (acknowledged in docs.z.ai/devpack/faq). The interval spaces call STARTS;
# this caps in-flight DEPTH. Flash-family models get a stricter sub-cap of
# min(2, this value) — the free pool is chronically saturated and community
# reports put its concurrency as low as 1. The cap is ADAPTIVE: external
# clients on the same plan (ZCode, chat) are invisible, so each 1302 /
# false 1113 yields one slot and ~20 clean responses earn it back. Workers
# queue here instead of being rejected by Z.AI; connections are pooled
# with keep-alive (60 s) under one shared httpx client.
BMF_LLM_MAX_INFLIGHT=3
# Leaky-bucket burst capacity (count-per-time limiter, NOT concurrency). Default
# 1 = pure even drip: exactly one LLM call starts every BMF_LLM_MIN_INTERVAL
# seconds, evenly spaced, no bunching. With interval 2.0s that is a steady
# 30 evenly-spaced requests/minute — what Z.AI's sliding-window limit wants.
# A burst >1 lets several calls fire in the same second, which trips the dynamic
# RPM limit (429). Raise only with confirmed rate headroom (e.g. a paid plan).
BMF_LLM_BURST=1.0
# Global 429/1302 cooldown. Z.AI returns HTTP 429 for THREE different
# conditions and bmf reacts differently to each (see docs.z.ai error codes):
#   1302 'Rate limit reached for requests' — our RPM rate tripped the window.
#       Z.AI's free tier also cascade-throttles every model when one 429s, so
#       when ANY worker sees a 1302, ALL workers pause. The cooldown escalates
#       5/10/20/... with consecutive 1302s, honours the server's Retry-After
#       when longer, and is capped by BMF_LLM_RATE_LIMIT_MAX.
#   1305 'service temporarily overloaded' — SERVER-side capacity (chronic on
#       the free flash models). Not our fault: bmf retries it shortly without
#       the global cooldown, then falls back to the paid model; a fleet-wide
#       streak of consecutive rejections parks the model for ~3 minutes.
#   1113 'insufficient balance' — on the coding endpoint this also fires in
#       short metering bursts despite quota left; same transient handling.
#       If it persists, check the plan balance / endpoint pairing above.
#   1308 'usage limit reached' — quota exhausted; the model is skipped for the
#       rest of the run.
# Lower base = more 429 risk; higher = slower.
BMF_LLM_RATE_LIMIT_BASE=5.0
BMF_LLM_RATE_LIMIT_MAX=60.0
