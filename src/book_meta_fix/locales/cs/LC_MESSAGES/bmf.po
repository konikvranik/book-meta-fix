#: src/book_meta_fix/cli.py:565
#, python-brace-format
msgid ""
"Target path pattern for OK books (default: '{author}/{title} ({id})'). "
"Applied books whose metadata is clean (or `verified`) move there; books "
"with unresolved problems move to --needfix-dir."
msgstr ""
