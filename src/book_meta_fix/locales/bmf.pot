msgstr ""

#: src/book_meta_fix/cli.py:205
msgid ""
"Enable legie.info lookup (CZ/SK sci-fi/fantasy — short stories & series "
"databazeknih misses). Implies --no-skip-enrich."
msgstr ""

#: src/book_meta_fix/cli.py:206
msgid "Skip content verification"
msgstr ""

#: src/book_meta_fix/cli.py:207
msgid ""
"Audit: also verify books the detectors marked OK against their content. "
"Reads every OK book's file (slower). A MISMATCH reclassifies it to "
"NEEDS_REVIEW and seeks a fix (enrichment + LLM). Use periodically to "
"catch corruption the structural detectors miss."
msgstr ""

#: src/book_meta_fix/cli.py:208
msgid ""
"With --verify-ok: only reclassify a clear MISMATCH (fuzzy title < 0.5). "
"By default (without this flag) UNCERTAIN (0.5–0.8) is also reclassified."
msgstr ""

#: src/book_meta_fix/cli.py:209
msgid ""
"Auto-accept MISSING_ISBN/YEAR/COVER books whose author+title were "
"confirmed against the book's content (pre-filled action: accept in "
"review.yaml; pruned by `bmf apply`, safe no-op). Default on. Use --no-"
"accept-missing to keep them for manual review."
msgstr ""

#: src/book_meta_fix/cli.py:210
msgid "Output review file (default: review.yaml)"
msgstr ""

#: src/book_meta_fix/cli.py:211
msgid "Enable LLM reconciliation (needs ZAI_API_KEY or BMF_LLM_MOCK=1)"
msgstr ""

#: src/book_meta_fix/cli.py:212
msgid ""
"Comma-separated categories to send to LLM, or 'ALL' (default). ALL = "
"every category except C9 (legitimate anonyms like the Bible, where an "
"LLM-invented author would be wrong). Each book is one LLM request that "
"returns all fields at once, so the cost is per-book, not per-category."
msgstr ""

#: src/book_meta_fix/cli.py:213
msgid "Parallel workers for I/O (extract/LLM/enrich). Default 10."
msgstr ""

#: src/book_meta_fix/cli.py:214
msgid ""
"Minimum seconds between LLM requests (RPM throttle, default 2.0 = ~30 "
"RPM). Decoupled from --workers: cheap I/O still runs at full worker "
"count. Lower (e.g. 1.0 = 60 RPM) on a higher Z.AI tier; raise (e.g. 4.0 ="
" 15 RPM) if you still hit 429."
msgstr ""

#: src/book_meta_fix/cli.py:215
msgid ""
"Primary model for the LLM loop (default glm-4.7-flash, the free first "
"attempt; with --no-llm-loop the fallback-quality model instead). "
"Alternatives: glm-4.6, glm-4.5-air, glm-4.5-flash. See README 'LLM model "
"choice' for the token/quality tradeoffs measured by "
"scripts/llm_experiment.py."
msgstr ""

#: src/book_meta_fix/cli.py:216
#, python-format
msgid ""
"reasoning_effort for GLM-5.x models: low (default) | medium | max. Lower "
"cuts reasoning tokens ~60%% vs max. Ignored by GLM-4.x (use --llm-"
"thinking)."
msgstr ""

#: src/book_meta_fix/cli.py:217
msgid ""
"thinking toggle for GLM-4.x models: disabled (default) | enabled. "
"'disabled' turns off chain-of-thought (3-4x fewer output tokens). Ignored"
" by GLM-5.x (use --llm-reasoning-effort)."
msgstr ""

#: src/book_meta_fix/cli.py:218
msgid ""
"Disable the self-correction loop. Default: loop on — try the free loop "
"model first (with verify feedback), then the paid fallback model. With "
"this flag, a single LLM call is used instead (the --llm-model, default "
"the fallback-quality one)."
msgstr ""

#: src/book_meta_fix/cli.py:219
msgid ""
"Paid high-quality fallback model (default glm-5.3). Used when the loop "
"model fails verify or is rate-limited; also the default single-call model"
" when the loop is off."
msgstr ""

#: src/book_meta_fix/cli.py:220
msgid ""
"Leaky-bucket burst capacity: how many LLM calls may start inside one "
"interval (default 1 = pure even drip, no bunching — one call every --llm-"
"min-interval seconds). This is a count-per-time limiter, not a "
"concurrency cap. Raise only with confirmed rate headroom; a burst >1 "
"fires multiple calls in the same second and trips Z.AI's dynamic RPM "
"limit (429)."
msgstr ""

#: src/book_meta_fix/cli.py:221
msgid ""
"Base seconds of the global cooldown applied when a 429 is seen (default "
"5). When ANY worker hits a 429, ALL workers pause this long; the cooldown"
" escalates 5/10/20/... with consecutive 429s, honours the server Retry-"
"After when longer, and is capped by --llm-rate-limit-max. Higher = safer "
"but slower; lower = more 429 risk."
msgstr ""

#: src/book_meta_fix/cli.py:222
msgid ""
"Cap (seconds) on the escalating 429 cooldown (default 60). Prevents a "
"sustained outage from parking workers indefinitely."
msgstr ""

