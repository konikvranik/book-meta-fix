#: src/book_meta_fix/review.py:70
#, python-brace-format
msgid ""
"Auto-generated by book-meta-fix on {date}\n"
"# {count} books need review.\n"
"# For each entry, set `action` to one of:\n"
"#   accept  - apply `proposed` (edit the values to override the\n"
"#             analyzer; a `null` value DELETES the field)\n"
"#   delete  - remove the book folder (C6 ~$ Word lock-file; tar.gz-"
"backed)\n"
"#   keep    - apply like accept, but the entry stays in this file\n"
"# Set `verified: true` to mark a book OK: apply stores the flag in\n"
"# metadata.json, later analyze runs skip the book and apply moves it\n"
"# to the target folder (`proposed.location`) like a clean book.\n"
"# The analyzer pre-fills this flag itself when the book's identity is\n"
"# confirmed against its content AND an online source — untick if you\n"
"# disagree.\n"
"# Then run: bmf apply review.yaml\n"
msgstr ""
"Automaticky vygenerováno nástrojem book-meta-fix dne {date}\n"
"# Ke kontrole: {count} knih(y).\n"
"# U každé položky nastavte `action` na jednu z hodnot:\n"
"#   accept  - aplikovat `proposed` (hodnoty lze upravit a přebít tak\n"
"#             analyzátor; hodnota `null` pole SMAŽE)\n"
"#   delete  - odstranit složku knihy (C6 ~$ zámek Wordu; se zálohou "
"tar.gz)\n"
"#   keep    - aplikuje jako accept, ale položka v tomto souboru zůstává\n"
"# Nastavte `verified: true`, když je kniha OK: apply uloží příznak do\n"
"# metadata.json, další běhy analyze knihu přeskočí a apply ji přesune\n"
"# na cílovou složku (`proposed.location`) jako čistou knihu.\n"
"# Analyzátor tento příznak předvyplní sám, když je identita knihy\n"
"# potvrzena proti jejímu obsahu A zároveň online zdrojem — v případě\n"
"# nesouhlasu odškrtněte.\n"
"# Pak spusťte: bmf apply review.yaml\n"

