msgstr "Zpracovat jen prvních N knih (pro testování)"

#: src/book_meta_fix/cli.py:135
msgid "Scanning"
msgstr "Skenuji"

#: src/book_meta_fix/cli.py:148 src/book_meta_fix/cli.py:202
