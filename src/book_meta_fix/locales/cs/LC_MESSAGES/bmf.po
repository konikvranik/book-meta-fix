#: src/book_meta_fix/review.py:62
msgid ""
"Auto-generated by book-meta-fix on {date}\n"
"# {count} books need review.\n"
"# For each entry, set `action` to one of:\n"
"#   accept  - apply `proposed` as-is\n"
"#   reject  - leave unchanged\n"
"#   swap    - swap author <-> title (for C1 cases)\n"
"#   edit    - apply fields under `edited` (uncomment and modify)\n"
"#   delete  - remove the book folder (C6 ~$ Word lock-file; tar.gz-"
"backed)\n"
"#   keep    - like accept, but retained (not pruned); skipped on next "
"analyze\n"
"# Then run: bmf apply review.yaml\n"
msgstr ""
"Automaticky vygenerováno nástrojem book-meta-fix dne {date}\n"
"# Ke kontrole: {count} knih(y).\n"
"# U každé položky nastavte `action` na jednu z hodnot:\n"
"#   accept  - aplikovat `proposed` tak, jak je\n"
"#   reject  - ponechat beze změny\n"
"#   swap    - prohodit autor <-> název (pro případy C1)\n"
"#   edit    - aplikovat pole pod `edited` (odkomentujte a upravte)\n"
"#   delete  - odstranit složku knihy (C6 ~$ zámek Wordu; se zálohou "
"tar.gz)\n"
"#   keep    - jako accept, ale ponecháno (neprořídí se); přeskočí se při "
"příštím analyze\n"
"# Pak spusťte: bmf apply review.yaml\n"
