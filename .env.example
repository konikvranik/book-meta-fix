# book-meta-fix configuration
# Copy to .env and edit. The .env file is loaded automatically — searched
# starting from the current directory, walking up to parents until found.
# Real environment variables always take precedence over .env values.

# Library root (the Calibre-style book directory)
BMF_LIBRARY=/mnt/share_nfs/Shared eBooks

# SQLite cache path (relative to CWD unless absolute)
BMF_CACHE=bmf_cache.db

# Default review file path
BMF_REVIEW=review.yaml

# Z.AI LLM (for C1/C4/C5 reconciliation — phase 7, optional)
# Get a key at https://z.ai/
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
ZAI_MODEL=glm-5.2
