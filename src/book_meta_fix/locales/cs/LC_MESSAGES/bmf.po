#: src/book_meta_fix/cli.py:2036
msgid "Library root"
msgstr "Kořen knihovny"

#: src/book_meta_fix/cli.py:241
msgid "Show only books in this category (C1..C10, MISSING_ISBN, ...)"
msgstr "Zobrazit jen knihy v této kategorii (C1..C10, MISSING_ISBN, ...)"

#: src/book_meta_fix/cli.py:242
msgid "Number of sample books to show per category"
msgstr "Počet ukázkových knih zobrazených na kategorii"

#: src/book_meta_fix/cli.py:243
msgid ""
"Apply the identity gate: a MISSING_ISBN/YEAR/COVER book whose "
"author+title are confirmed against its content counts as OK (not broken)."
" Default on, consistent with organize/analyze. --no-accept-missing keeps "
"the pure detector verdict (no content reads; the historic fast report)."
msgstr ""
"Aplikovat identitní bránu: kniha MISSING_ISBN/YEAR/COVER, jejíž "
"autor+název jsou potvrzeny proti obsahu, se počítá jako OK (není "
"poškozená). Výchozí zapnuto, konzistentní s organize/analyze. --no-"
"accept-missing ponechá čistý verdikt detektorů (žádné čtení obsahu; "
"historický rychlý report)."

#: src/book_meta_fix/cli.py:244
msgid ""
"Audit: also verify books the detectors marked OK against their content. "
"Reads every OK book's file (slower). A MISMATCH (or UNCERTAIN, see --no-"
"strict-verify) is then counted as broken."
msgstr ""
"Audit: ověřit proti obsahu i knihy, které detektory označily jako OK. "
"Načte soubor každé OK knihy (pomalejší). MISMATCH (nebo UNCERTAIN, viz "
"--no-strict-verify) se pak počítá jako poškozená."

#: src/book_meta_fix/cli.py:245
msgid ""
"With --verify-ok: only treat a clear MISMATCH as broken. By default "
"UNCERTAIN is too."
msgstr ""
"S --verify-ok: jako poškozenou brát jen jednoznačný MISMATCH. Jinak se "
"výchozí počítá i UNCERTAIN."

#: src/book_meta_fix/cli.py:279
msgid "Classifying"
msgstr "Klasifikuji"

#: src/book_meta_fix/cli.py:291
#, python-brace-format
msgid ""
"{identified} book(s) identified (accepted): MISSING_* with author+title "
"confirmed against content — these route to OK, not needfix."
msgstr ""
"Identifikováno (přijato) knih: {identified}: MISSING_* s autorem+názvem "
"potvrzenými proti obsahu — tyto míří do OK, ne do needfix."

#: src/book_meta_fix/cli.py:302
msgid "Skip online enrichment (offline mode)"
msgstr "Přeskočit online obohacení (offline režim)"

#: src/book_meta_fix/cli.py:303
msgid "Enable/disable databazeknih.cz lookup (default: enabled)"
msgstr "Zapnout/vypnout dotazy na databazeknih.cz (výchozí: zapnuto)"

#: src/book_meta_fix/cli.py:304
msgid "Enable/disable legie.info lookup (default: enabled)"
msgstr "Zapne/vypne dotazy na legie.info (výchozí: zapnuto)"

#: src/book_meta_fix/cli.py:305
msgid ""
"Use a self-hosted audiobookshelf_czech_metadata instance at this base URL"
" (aggregates ~17 CZ audiobook storefronts — audio-edition metadata). Also"
" settable via BMF_ABS_CZECH_URL."
msgstr ""
"Použít self-hosted instanci audiobookshelf_czech_metadata na této base "
"URL (agreguje ~17 CZ audiobookových obchodů — metadata audio edic). Lze "
"též nastavit přes BMF_ABS_CZECH_URL."

#: src/book_meta_fix/cli.py:306
msgid "Skip content verification"
msgstr "Přeskočit ověření obsahem"

#: src/book_meta_fix/cli.py:307
msgid ""
"Audit: also verify books the detectors marked OK against their content. "
"Reads every OK book's file (slower). A MISMATCH reclassifies it to "
"NEEDS_REVIEW and seeks a fix (enrichment + LLM). Use periodically to "
"catch corruption the structural detectors miss."
msgstr ""
"Audit: ověřit proti obsahu i knihy, které detektory označily jako OK. "
"Načte soubor každé OK knihy (pomalejší). MISMATCH překlasifikuje na "
"NEEDS_REVIEW a hledá opravu (obohacení + LLM). Spouštějte pravidelně, "
"abyste odhalili poškození, která strukturální detektory přehlédnou."

#: src/book_meta_fix/cli.py:308
msgid ""
"With --verify-ok: only reclassify a clear MISMATCH (fuzzy title < 0.5). "
"By default (without this flag) UNCERTAIN (0.5–0.8) is also reclassified."
msgstr ""
"S --verify-ok: překlasifikovat jen jednoznačný MISMATCH (fuzzy název < "
"0,5). Výchozí (bez tohoto přepínače) se překlasifikuje i UNCERTAIN "
"(0,5–0,8)."

#: src/book_meta_fix/cli.py:309
msgid ""
"Auto-accept MISSING_ISBN/YEAR/COVER books whose author+title were "
"confirmed against the book's content (pre-filled action: accept in "
"review.yaml; pruned by `bmf apply`, safe no-op). Default on. Use --no-"
"accept-missing to keep them for manual review."
msgstr ""
"Automaticky přijmout knihy MISSING_ISBN/YEAR/COVER, jejichž autor+název "
"byly potvrzeny proti obsahu knihy (předvyplněné action: accept v "
"review.yaml; `bmf apply` je proředí, bezpečný no-op). Výchozí zapnuto. "
"Použijte --no-accept-missing, chcete-li je ponechat k ručnímu schválení."

#: src/book_meta_fix/cli.py:310
#, python-brace-format
msgid ""
"Target path pattern for OK books (default: '{author}/{title} ({id})'). "
"Drives the C13 location detector: a book not sitting at its pattern path "
"enters review with a move proposal that `bmf apply` executes."
msgstr ""
"Cílový vzor cesty pro OK knihy (výchozí: '{author}/{title} ({id})'). Žene"
" detektor C13: kniha, která nesedí na své vzorové cestě, jde do review s "
"návrhem na přesun, který provede `bmf apply`."

#: src/book_meta_fix/cli.py:311
msgid ""
"Skip the C13 location check (analyze metadata only, no placement "
"proposals)."
msgstr "Přeskočit kontrolu umístění C13 (pouze metadata, bez návrhů na přesun)."

#: src/book_meta_fix/cli.py:312
msgid ""
"Clear the `verified` flag (see review.yaml / the GUI checkbox) from every"
" book, returning user-confirmed books to normal detection. Undo of a too-"
"hasty OK."
msgstr ""
"Vymazat příznak `verified` (viz review.yaml / checkbox v GUI) ze všech "
"knih a vrátit uživatelem potvrzené knihy do normální detekce. Odvolání "
"ukvapeného OK."

#: src/book_meta_fix/cli.py:313
msgid ""
"Run the library-wide normalize pass (C15 author variants / C16 genre "
"variants / C18 series-name variants) at the end, over the books this "
"analyze already scanned — no second library scan. Proposals are merged "
"into the same review file; review with `bmf gui`, write with `bmf apply`."
msgstr ""
"Spustit na konci běhu celoknihovní normalize pass (C15 varianty jmen "
"autorů / C16 varianty žánrů / C18 varianty názvů sérií) nad knihami, "
"které tento analyze už proskenoval — bez druhého skenu knihovny. Návrhy "
"se přidají do stejného review souboru; zkontrolujte přes `bmf gui`, "
"zapište přes `bmf apply`."

#: src/book_meta_fix/cli.py:314
msgid ""
"Also propose merging duplicate folders of the same work (C19) at the end,"
" over the books this analyze already scanned. ISBN-confirmed duplicates "
"arrive pre-filled action: merge, the rest pending; `bmf apply` executes "
"them."
msgstr ""
"Na konci navrhne i sloučení duplicitních složek téhož díla (C19), nad "
"knihami, které tento analyze už prošel. ISBN-potvrzené duplicity přijdou "
"předvyplněné action: merge, ostatní zůstávají pending; provede je `bmf "
"apply`."

#: src/book_meta_fix/cli.py:315
msgid "Output review file (default: review.yaml)"
msgstr "Výstupní kontrolní soubor review.yaml (výchozí: review.yaml)"

#: src/book_meta_fix/cli.py:316
msgid ""
"Enable/disable LLM reconciliation (default: disabled — online sources "
"only, no LLM; pass --llm to opt in)"
msgstr ""
"Zapnout/vypnout LLM rekonciliaci (výchozí: vypnuto — jen online zdroje, "
"bez LLM; zapněte příznakem --llm)"

#: src/book_meta_fix/cli.py:317
msgid ""
"Force the LLM provider branch (default: auto — Antigravity ACP when an "
"agent is configured or cached, else Z.AI when ZAI_API_KEY is set). "
"'antigravity' = the ACP agent is the fast tier and Z.AI (if a key exists)"
" only the paid fallback; 'zai' never uses ACP."
msgstr ""
"Vynutit větev LLM providera (výchozí: auto — Antigravity ACP, když je "
"agent nastaven nebo nakešován, jinak Z.AI při ZAI_API_KEY). 'antigravity'"
" = ACP agent je rychlá vrstva a Z.AI (pokud existuje klíč) jen placená "
"záloha; 'zai' ACP nepoužívá."

#: src/book_meta_fix/cli.py:318
msgid ""
"Command that launches an Agent Client Protocol agent process (ACP v1 over"
" stdio) — a Google Antigravity subscription as the FAST LLM tier. The "
"official agent is `agy_acp_server.par` from the ACP Registry (release "
"zips need chmod +x); any ACP agent works, e.g. `gemini --acp`. 'auto' (or"
" empty) = bmf's SELF-MANAGED agent: the run checks the registry, "
"downloads (~700 MB / 1.9 GB unpacked, into ~/.cache/book-meta-fix/acp) "
"and upgrades it itself; an explicit path manages it manually. Same as "
"BMF_ANTIGRAVITY_CMD."
msgstr ""
"Příkaz, který spustí agentní proces Agent Client Protocol (ACP v1 přes "
"stdio) — předplatné Google Antigravity jako RYCHLÁ vrstva LLM. Oficiální "
"agent je `agy_acp_server.par` z ACP Registry (rozbalené zipy potřebují "
"chmod +x); funguje jakýkoli ACP agent, např. `gemini --acp`. 'auto' (nebo"
" prázdné) = SAMOSPRÁVNÝ agent bmf: běh sám zkontroluje registr, stáhne "
"(~700 MB / 1,9 GB rozbalené, do ~/.cache/book-meta-fix/acp) a aktualizuje"
" ho; explicitní cesta znamená ruční správu. Totéž co BMF_ANTIGRAVITY_CMD."

#: src/book_meta_fix/cli.py:319
msgid ""
"Model the ACP agent should serve the fast tier with (matched against the "
"agent's session config options by exact value/name or token family, so "
"'gemini-flash' picks 'gemini-3.8-flash-high'; empty = the agent's default"
" pick). Default gemini-flash-low — the newest flash at low effort (the "
"quick check wants latency, not deliberation). Same as "
"BMF_ANTIGRAVITY_MODEL."
msgstr ""
"Model, který má ACP agent pro rychlou vrstvu používat (porovnává se s "
"config volbami relace agenta přesně podle hodnoty/názvu nebo po tokenech "
"rodiny, takže „gemini-flash“ vybere „gemini-3.8-flash-high“; prázdné = "
"výchozí volba agenta). Výchozí gemini-flash-low — nejnovější flash na low"
" effort (rychlá kontrola chce latenci, ne dumování). Totéž co "
"BMF_ANTIGRAVITY_MODEL."

#: src/book_meta_fix/cli.py:320
msgid ""
"Who serves the loop's QUALITY stage when the ACP agent is the fast tier: "
"'agy' (default — a second ACP pool on the fallback model, the whole loop "
"stays on the subscription) or 'glm' (the Z.AI flash+paid loop; needs "
"ZAI_API_KEY). Same as BMF_ANTIGRAVITY_FALLBACK."
msgstr ""
"Kdo obsluhuje KVALITNÍ fázi smyčky, když je ACP agent rychlou vrstvou: "
"„agy“ (výchozí — druhý ACP pool na fallback modelu, celá smyčka zůstane "
"na předplatném) nebo „glm“ (smyčka flash+placené Z.AI; potřebuje "
"ZAI_API_KEY). Totéž co BMF_ANTIGRAVITY_FALLBACK."

#: src/book_meta_fix/cli.py:321
msgid ""
"Model for the agy quality stage, family-matched like --antigravity-model "
"(empty = the agent's default pick). Default gemini-flash-high. Ignored "
"with --antigravity-fallback glm. Same as BMF_ANTIGRAVITY_FALLBACK_MODEL."
msgstr ""
"Model pro kvalitní fázi agy, párovaný po rodině jako --antigravity-model "
"(prázdné = výchozí volba agenta). Výchozí gemini-flash-high. S "
"--antigravity-fallback glm se ignoruje. Totéž co "
"BMF_ANTIGRAVITY_FALLBACK_MODEL."

#: src/book_meta_fix/cli.py:322
msgid ""
"Comma-separated categories to send to LLM, or 'ALL' (default). ALL = "
"every category except C9 (legitimate anonyms like the Bible, where an "
"LLM-invented author would be wrong). Each book is one LLM request that "
"returns all fields at once, so the cost is per-book, not per-category."
msgstr ""
"Čárkou oddělené kategorie posílané do LLM, nebo 'ALL' (výchozí). ALL = "
"všechny kategorie kromě C9 (legitimní anonymové jako Bible, kde by "
"autorem vymyšleným LLM byl chybný). Každá kniha je jeden LLM požadavek, "
"který vrátí všechna pole najednou, takže cena je za knihu, ne za "
"kategorii."

#: src/book_meta_fix/cli.py:323
msgid "Parallel workers for I/O (extract/LLM/enrich). Default 10."
msgstr "Paralelních workerů pro I/O (extrakce/LLM/obohacení). Výchozí 10."

#: src/book_meta_fix/cli.py:325
msgid ""
"Minimum seconds between LLM requests (RPM throttle, default 2.0 = ~30 "
"RPM). Decoupled from --workers: cheap I/O still runs at full worker "
"count. Lower (e.g. 1.0 = 60 RPM) on a higher Z.AI tier; raise (e.g. 4.0 ="
" 15 RPM) if you still hit 429."
msgstr ""
"Minimální sekundy mezi LLM požadavky (RPM škrtidlo, výchozí 2,0 = ~30 "
"RPM). Nezávislé na --workers: levné I/O stále běží s plným počtem "
"workerů. Snižte (např. 1,0 = 60 RPM) na vyšším Z.AI tarifu; zvyšte (např."
" 4,0 = 15 RPM), pokud stále narážíte na 429."

#: src/book_meta_fix/cli.py:326
msgid ""
"Primary model for the LLM loop (default glm-4.7-flash, the free first "
"attempt; with --no-llm-loop the fallback-quality model instead). "
"Alternatives: glm-4.6, glm-4.5-air, glm-4.5-flash. See README 'LLM model "
"choice' for the token/quality tradeoffs measured by "
"scripts/llm_experiment.py."
msgstr ""
"Primární model LLM smyčky (výchozí glm-4.7-flash, bezplatný první pokus; "
"s --no-llm-loop místo něj model záložní kvality). Alternativy: glm-4.6, "
"glm-4.5-air, glm-4.5-flash. Viz README 'LLM model choice' pro poměr "
"tokeny/kvalita změřený scripts/llm_experiment.py."

#: src/book_meta_fix/cli.py:327
#, python-format
msgid ""
"reasoning_effort for GLM-5.x models: low (default) | medium | max. Lower "
"cuts reasoning tokens ~60%% vs max. Ignored by GLM-4.x (use --llm-"
"thinking)."
msgstr ""
"reasoning_effort pro modely GLM-5.x: low (výchozí) | medium | max. Nižší "
"ušetří ~60%% reasoning tokenů oproti max. GLM-4.x ignoruje (použijte "
"--llm-thinking)."

#: src/book_meta_fix/cli.py:328
msgid ""
"thinking toggle for GLM-4.x models: disabled (default) | enabled. "
"'disabled' turns off chain-of-thought (3-4x fewer output tokens). Ignored"
" by GLM-5.x (use --llm-reasoning-effort)."
msgstr ""
"Přepínač thinking pro modely GLM-4.x: disabled (výchozí) | enabled. "
"'disabled' vypne chain-of-thought (3-4x méně výstupních tokenů). GLM-5.x "
"ignoruje (použijte --llm-reasoning-effort)."

#: src/book_meta_fix/cli.py:329
msgid ""
"Disable the self-correction loop. Default: loop on — try the free loop "
"model first (with verify feedback), then the paid fallback model. With "
"this flag, a single LLM call is used instead (the --llm-model, default "
"the fallback-quality one)."
msgstr ""
"Vypne samoopravovací smyčku. Výchozí: smyčka zapnutá — nejdřív bezplatný "
"model smyčky (s zpětnou vazbou z verify), pak placený záložní model. S "
"tímto přepínačem se použije jediné volání LLM (--llm-model, výchozí model"
" záložní kvality)."

#: src/book_meta_fix/cli.py:330
msgid ""
"Paid high-quality fallback model (default glm-5.3). Used when the loop "
"model fails verify or is rate-limited; also the default single-call model"
" when the loop is off."
msgstr ""
"Placený záložní model vysoké kvality (výchozí glm-5.3). Použije se, když "
"model smyčky neprojde verify nebo narazí na rate limit; též výchozí model"
" pro jediné volání, když je smyčka vypnutá."

#: src/book_meta_fix/cli.py:331
msgid ""
"Leaky-bucket burst capacity: how many LLM calls may start inside one "
"interval (default 1 = pure even drip, no bunching — one call every --llm-"
"min-interval seconds). This is a count-per-time limiter, not a "
"concurrency cap. Raise only with confirmed rate headroom; a burst >1 "
"fires multiple calls in the same second and trips Z.AI's dynamic RPM "
"limit (429)."
msgstr ""
"Kapacita shluku leaky-bucket: kolik LLM volání může začít uvnitř jednoho "
"intervalu (výchozí 1 = čistý rovnoměrný odkap, bez shlukování — jedno "
"volání každých --llm-min-interval sekund). Je to omezovač počtu-za-čas, "
"ne cap souběžnosti. Zvyšte jen s potvrzenou rezervou v rate limitu; shluk"
" >1 vystřelí více volání ve stejné sekundě a naruší dynamický RPM limit "
"Z.AI (429)."

#: src/book_meta_fix/cli.py:332
msgid ""
"Base seconds of the global cooldown applied when a 429 is seen (default "
"5). When ANY worker hits a 429, ALL workers pause this long; the cooldown"
" escalates 5/10/20/... with consecutive 429s, honours the server Retry-"
"After when longer, and is capped by --llm-rate-limit-max. Higher = safer "
"but slower; lower = more 429 risk."
msgstr ""
"Základní sekundy globální cooldownu aplikovaného při 429 (výchozí 5). "
"Když KDOKOLIV z workerů dostane 429, pozastaví se VŠICHNI workerové na "
"tuto dobu; cooldown eskaluje 5/10/20/... při po sobě jdoucích 429, "
"respektuje delší serverové Retry-After a je omezen stropem --llm-rate-"
"limit-max. Vyšší = bezpečnější, ale pomalejší; nižší = větší riziko 429."

#: src/book_meta_fix/cli.py:333
msgid ""
"Cap (seconds) on the escalating 429 cooldown (default 60). Prevents a "
"sustained outage from parking workers indefinitely."
msgstr ""
"Strop (sekundy) eskalujícího 429 cooldownu (výchozí 60). Zabraňuje, aby "
"trvalý výpadek zaparkoval workery na neurčito."

#: src/book_meta_fix/cli.py:334
msgid ""
"Hard cap on LLM requests running at the same instant (default 3). The "
"Z.AI coding plan admits only ~5 concurrent requests per account "
"(interactive clients draw from the same ceiling), so a deep fallback herd"
" gets 429/1302 storms — and false 1113 'insufficient balance' — no matter"
" how slow the drip is. Workers queue on this instead of being rejected. "
"Flash-family models get a stricter sub-cap of min(2, this value)."
msgstr ""
"Tvrdý strop LLM požadavků běžících ve stejný okamžik (výchozí 3). Coding "
"plan Z.AI připouští jen ~5 souběžných požadavků na účet (interaktivní "
"klienti čerpají ze stejného stropu), takže hluboké fallback stádo dostává"
" 429/1302 bouře — a falešné 1113 „insufficient balance“ — bez ohledu na "
"to, jak pomalý je drip. Workeři místo odmítnutí čekají ve frontě tady. "
"Flash-modely dostávají přísnější sub-strop min(2, tato hodnota)."

#: src/book_meta_fix/cli.py:371
msgid "lookup enabled (genres + metadata)"
msgstr "dotaz zapnut (žánry + metadata)"

#: src/book_meta_fix/cli.py:372
msgid "cover replacement"
msgstr "náhrada obálky"

#: src/book_meta_fix/cli.py:372
msgid ""
"enabled (C11 generated / MISSING_COVER → cover_url from online sources; "
"the two CZ ones cross-compared for the larger image)"
msgstr ""
"zapnuto (C11 generovaná / MISSING_COVER → cover_url z online zdrojů; dva "
"CZ zdroje se pro porovnání zkříží a bere se větší obrázek)"

#: src/book_meta_fix/cli.py:374
msgid "lookup enabled (sci-fi/fantasy — short stories & series)"
msgstr "dotaz zapnut (sci-fi/fantasy — povídky a série)"

#: src/book_meta_fix/cli.py:376
msgid "CZ audiobook provider lookup enabled (storefront aggregator)"
