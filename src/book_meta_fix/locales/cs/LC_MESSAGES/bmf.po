#: src/book_meta_fix/cli.py:208 src/book_meta_fix/cli.py:239
#: src/book_meta_fix/cli.py:300
msgid "Disable SQLite cache (force full re-parse)"
msgstr "Vypnout SQLite cache (vynutit úplné znovunačtení)"

#: src/book_meta_fix/cli.py:209 src/book_meta_fix/cli.py:240
